{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Curto": {
    "BaseUrl": "",
    "DbPath": "data/curto.db",
    "ApiKey": "",
    "BlockPrivateTargets": false,
    "RetentionDays": 180,
    "MaxRequestBodyBytes": 16384,
    "SseHeartbeatSeconds": 15,
    "SseMaxSubscribers": 100,
    "RateLimits": {
      "RedirectPerMinute": 120,
      "CreatePerMinute": 20,
      "ApiPerMinute": 300
    },
    "Clicks": {
      "QueueCapacity": 10000,
      "BatchSize": 500,
      "FlushIntervalMs": 250
    }
  }
}
